APP_NAME="Meta Inbox"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://inbox.yourdomain.com
APP_TIMEZONE=Asia/Kathmandu

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Meta (Facebook) app: developers.facebook.com/apps
META_APP_ID=
META_APP_SECRET=
# Any long secret text; paste the same value in the Meta webhook settings
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v24.0

# Shown on the public /privacy page (needed for Meta App Review)
BUSINESS_NAME=
CONTACT_EMAIL=

# Shown before amounts in orders and Excel exports
CURRENCY=Rs.
